<section class="hero">
  <div class="hero__content">
    <p class="hero__eyebrow">Auditoria ativa de uptime · Proteção de Ads</p>
    <h1 class="hero__title">
      Para Agências de Performance e Gestores de Tráfego.
    </h1>
    <p class="hero__lede">
