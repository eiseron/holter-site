    display: flex;
    align-items: center;
  }

  .hero__content {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-6);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, var(--font-size-display));
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0 0 var(--space-6);
    color: var(--color-text);
    text-shadow: 0 0 12px var(--color-bg);
  }

  .hero__lede {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
