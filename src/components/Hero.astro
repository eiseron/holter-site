---

---

<section class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">Auditoria ativa de uptime · Proteção de Ads</p>
    <h1 class="hero__title">
      Para Agências de Performance e Gestores de Tráfego.
    </h1>
    <p class="hero__lede">
      O Holter audita a integridade dos sites de seus clientes 24 horas por dia
      e pausa anúncios no Google Ads e Meta Ads ao detectar uma queda. Sua verba
      não financia páginas indisponíveis.
    </p>

    <div
      class="hero__pulse"
      role="img"
      aria-label="Sinal de pulso oscilando entre online e offline"
    >
      <svg
        viewBox="0 0 800 160"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
      >
        <line class="hero__pulse-baseline" x1="0" y1="80" x2="800" y2="80"
        ></line>
        <polyline
          class="hero__pulse-line"
          points="0,80 120,80 140,80 160,30 180,130 200,80 360,80 380,80 400,30 420,130 440,80 600,80 620,80 640,30 660,130 680,80 800,80"
        ></polyline>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-12) var(--space-6) var(--space-10);
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-6);
  }

  .hero__title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(2rem, 5.5vw, var(--font-size-display));
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0 0 var(--space-6);
    color: var(--color-text);
  }

  .hero__lede {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin: 0 0 var(--space-10);
  }

  .hero__pulse {
    width: 100%;
    height: 160px;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-subtle);
  }

  .hero__pulse svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__pulse-baseline {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .hero__pulse-line {
    fill: none;
    stroke: var(--prim-cyber-blue);
    stroke-width: 2;
    stroke-linejoin: miter;
    stroke-dasharray: 1600;
    stroke-dashoffset: 1600;
    animation: hero-pulse-trace 3.6s linear infinite;
  }

  @keyframes hero-pulse-trace {
    0% {
      stroke-dashoffset: 1600;
      stroke: var(--prim-cyber-blue);
    }
    70% {
      stroke-dashoffset: 0;
      stroke: var(--prim-cyber-blue);
    }
    78% {
      stroke: var(--prim-alert-red);
    }
    100% {
      stroke-dashoffset: -1600;
      stroke: var(--prim-cyber-blue);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse-line {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
